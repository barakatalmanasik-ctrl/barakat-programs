{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "**/node_modules/**",
      "barakat-app/**",
      "supabase/**",
      "vercel.json",
      ".gitignore",
      ".env.example",
      "*.md"
    ],
    "rewrites": [
      {
        "source": "/admin/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ]
  }
}
